{
    "name": "backend-api",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx src/server.ts",
        "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
        "start": "node dist/server.js",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "express": "^4.21.2",
        "dotenv": "^17.2.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "tsx": "^4.21.0",
        "esbuild": "^0.25.0",
        "typescript": "~5.8.2"
    }
}